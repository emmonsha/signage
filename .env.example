# Скопируйте в .env и заполните:  cp .env.example .env && chmod 600 .env

# --- Пароль админки (нужен один из вариантов) ---
# Рекомендуется хэш. Создать:  docker compose run --rm --no-deps signage node hash-password.js
#                       или:  npm run hash-password
# Потеряли пароль:  scripts/reset-password.sh  (подробнее в README, раздел «Потерян пароль»)
ADMIN_PASSWORD_HASH=
# Запасной вариант — пароль в открытом виде (если задан хэш, пароль игнорируется):
ADMIN_PASSWORD=

# --- Доступ к админке только из этих сетей (CIDR через запятую); пусто = из любой сети ---
# Плееры BrightSign (/player, плейлисты, картинки) эта настройка не затрагивает.
# 172.16.0.0/12 нужна, если вы заходите с самого Docker-хоста: запросы приходят с адреса моста Docker.
ADMIN_ALLOWED_NETS=

# --- Необязательное ---
PORT=3000                  # порт на хосте
SCREENS=left,right,big_wall
MAX_PDF_PAGES=50
MAX_VIDEO_MB=2048           # максимальный размер видео при загрузке
MAX_VIDEO_SECONDS=900      # максимальная длина ролика
VIDEO_MAX_FPS=60           # потолок частоты кадров; для слабых моделей плеера поставьте 30
VIDEO_THREADS=             # потоков ffmpeg (пусто = авто); на общем сервере удобно ограничить, например 4
VIDEO_PRESET=medium        # veryfast быстрее, slow лучше сжимает
TZ=UTC
# SESSION_SECRET=          # не нужен: по умолчанию случайный при каждом старте

# Только если админка открыта через обратный прокси с https:
TRUST_PROXY=               # число прокси перед сервером, обычно 1
COOKIE_SECURE=false        # true — cookie только по https
