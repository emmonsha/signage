# Скопируйте в .env и заполните:  cp .env.example .env && chmod 600 .env

# --- Пароль админки (нужен один из вариантов) ---
# Рекомендуется хэш. Создать:  docker compose run --rm --no-deps signage node hash-password.js
#                       или:  npm run hash-password
# Потеряли пароль:  scripts/reset-password.sh  (подробнее в README, раздел «Потерян пароль»)
ADMIN_PASSWORD_HASH=
# Запасной вариант — пароль в открытом виде (если задан хэш, пароль игнорируется):
ADMIN_PASSWORD=

# --- Аутентификация: local | freeipa | both ---
# local   — только локальный пароль админки (по умолчанию, если FreeIPA не включён);
# freeipa — только вход через FreeIPA (локальный пароль не используется);
# both    — FreeIPA, а при недоступности каталога разрешён аварийный вход локальной учёткой.
# Если не задано: freeipa при FREEIPA_ENABLED=true, иначе local.
AUTH_MODE=
# Логин локального администратора (используется в режимах local/both):
ADMIN_USER=admin

# --- FreeIPA (LDAP) ---
# Включить вход через каталог:
FREEIPA_ENABLED=false
# Адрес каталога. Можно задать полным URL — он имеет приоритет:
FREEIPA_URL=ldaps://ipa.example.com:636
# …либо собрать из частей (удобно, если в вашей сети нестандартные порты):
# FREEIPA_HOST=ipa.example.com
# FREEIPA_SCHEME=ldaps           # ldap | ldaps; по умолчанию: ldap при порте 389, иначе ldaps
# FREEIPA_PORT=1636              # если пусто: 636 для ldaps, 389 для ldap
# Базовый DN каталога и контейнер, где искать пользователей:
FREEIPA_BASE_DN=dc=example,dc=com
FREEIPA_USER_BASE_DN=cn=users,cn=accounts,dc=example,dc=com
# Сервисная учётка для поиска (в FreeIPA заведите отдельного пользователя с правом чтения):
FREEIPA_BIND_DN=uid=signage-bind,cn=users,cn=accounts,dc=example,dc=com
FREEIPA_BIND_PASSWORD=
# Фильтр поиска пользователя; {username} подставляется из поля ввода:
FREEIPA_USER_FILTER=(uid={username})
# StartTLS для ldap:// (для ldaps:// не нужно):
FREEIPA_STARTTLS=false
# Проверка сертификата сервера; CA-файл, если сертификат самоподписанный:
FREEIPA_TLS_CA_FILE=
FREEIPA_TLS_REJECT_UNAUTHORIZED=true
# Таймаут операций, мс:
FREEIPA_TIMEOUT_MS=5000
# Ограничение по группе (полный DN группы) — пусто = без ограничения:
FREEIPA_REQUIRE_GROUP=
# Кто может входить через каталог. В FreeIPA, кроме вашей команды, обычно есть и обычные
# сотрудники: без ограничения любой из них войдёт в админку со своим доменным паролем.
#   auto (по умолчанию) — список допущенных не пуст => пускаем только его; пуст => всех (как раньше);
#   list — всегда только список (заведите хотя бы одного, иначе войти будет некому);
#   open — всегда пускать всех из каталога (ограничение выключено).
# Сам список ведётся в админке, раздел «Доступ» (файл data/users.json). Пароли там не хранятся —
# вход по-прежнему проверяется в каталоге.
FREEIPA_ACCESS_MODE=auto

# --- Доступ к админке только из этих сетей (CIDR через запятую); пусто = из любой сети ---
# Плееры (/player, плейлисты, картинки) эта настройка не затрагивает.
# 172.16.0.0/12 нужна, если вы заходите с самого Docker-хоста: запросы приходят с адреса моста Docker.
ADMIN_ALLOWED_NETS=

# --- Необязательное ---
PORT=3000                  # порт на хосте
# Экраны при первом запуске. Дальше имена и токены ссылок живут в data/screens.json
# и правятся в админке (переименование, добавление, перевыпуск ссылки).
SCREENS=left,right,big_wall
MAX_PDF_PAGES=50
MAX_VIDEO_MB=2048           # максимальный размер видео при загрузке
MAX_VIDEO_SECONDS=900      # максимальная длина ролика
VIDEO_MAX_FPS=60           # потолок частоты кадров; для слабых моделей плеера поставьте 30
# VIDEO_THREADS: потоков ffmpeg (пусто = авто); на общем сервере удобно ограничить, например 4
VIDEO_THREADS=
VIDEO_PRESET=medium        # veryfast быстрее, slow лучше сжимает
TZ=UTC
# Сессии админки хранятся в файле на томе STORAGE_DIR и переживают перезапуск контейнера.
# SESSION_SECRET нужен только для нескольких копий сервера за балансировщиком.
# Если не задан — секрет создаётся в STORAGE_DIR/data/.session-secret и сохраняется.
# SESSION_SECRET=

# Только если админка открыта через обратный прокси с https:
# TRUST_PROXY: число прокси перед сервером, обычно 1
TRUST_PROXY=
COOKIE_SECURE=false        # true — cookie только по https

# --- Снапшоты экранов (реальный кадр с плеера через Local DWS) ---
# Адрес каждого плеера (IP/хост, порт) задаётся в админке в карточке экрана и хранится в data/players.json.
# Логин/пароль Local DWS плеера:
PLAYER_DWS_USER=admin
PLAYER_DWS_PASSWORD=
# Схема и порт DWS (если не указаны в адресе экрана): http/80 или https/443
PLAYER_DWS_SCHEME=http
PLAYER_DWS_PORT=80
# Переопределение логина/пароля для конкретного экрана (имя экрана в верхнем регистре, не-буквы -> _):
# PLAYER_DWS_BIG_WALL_PASSWORD=...
# Кадр в оригинальном разрешении плеера (true) или уменьшенный (false):
SNAPSHOT_ORIGINAL=true
# Сколько последних кадров хранить на экран (старые удаляются):
SNAPSHOT_KEEP=20
# Таймаут обращения к плееру, мс:
SNAPSHOT_TIMEOUT_MS=15000

# --- Автодеплой (кнопка «Обновить систему» в админке) ---
# Контейнер шлёт команду мини-агенту на хосте (deploy-agent.js, systemd), который делает
# git pull + docker compose up -d --build. Агент слушает loopback, доступ — по общему токену.
# Установка агента на хосте: scripts/install-deploy-agent.sh (см. docs/05_AUTODEPLOY.md).
DEPLOY_ENABLED=false
DEPLOY_AGENT_URL=http://127.0.0.1:9123
# Тот же токен, что в /etc/signage/deploy-agent.env на хосте:
DEPLOY_AGENT_TOKEN=
